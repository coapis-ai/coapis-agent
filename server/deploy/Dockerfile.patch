# ───────────────────────────────────────────────────────────────────
# CoApis 快速 Patch 镜像 —— 只覆盖本次改动文件
# 基于当前 coapis-agent:latest，秒级构建
# 改动内容：v0.11.2 Shared Runtime Pool + install_dependency + MCP env 合并
# ───────────────────────────────────────────────────────────────────
FROM coapis-agent:latest

# 1. 更新 entrypoint（共享运行时池初始化、min 镜像渠道包路径迁移）
COPY server/deploy/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# 2. 更新源码文件
COPY server/coapis/__version__.py /app/coapis/__version__.py
COPY server/coapis/agents/tools/install_dependency.py /app/coapis/agents/tools/install_dependency.py
COPY server/coapis/agents/tools/_auto_register.py /app/coapis/agents/tools/_auto_register.py
COPY server/coapis/app/mcp/manager.py /app/coapis/app/mcp/manager.py

# 3. 保持原镜像入口点不变
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
