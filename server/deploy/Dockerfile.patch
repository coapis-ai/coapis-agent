# ───────────────────────────────────────────────────────────────────
# CoApis 快速 Patch 镜像 —— 基于 0.11.3 覆盖本次后端改动文件
# 构建：docker build -f server/deploy/Dockerfile.patch -t coapis-agent:0.11.3-patch2 ..
# ───────────────────────────────────────────────────────────────────
FROM coapis-agent:0.11.3 AS patch

# 覆盖 0.11.3 之后合并的后端修复（技能默认启用 + 工具调用 PolicyContext import 修复）
COPY coapis-agent/server/coapis/agents/skills_hub.py /app/coapis/agents/skills_hub.py
COPY coapis-agent/server/coapis/agents/skills_manager.py /app/coapis/agents/skills_manager.py
COPY coapis-agent/server/coapis/app/routers/skills.py /app/coapis/app/routers/skills.py
COPY coapis-agent/server/coapis/agents/react_agent.py /app/coapis/agents/react_agent.py

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["uvicorn", "coapis.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
