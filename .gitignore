# ============================================================
# CoApis .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/
*.whl
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/

# --- Node.js / Frontend ---
node_modules/
*.local
.DS_Store

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Environment / Secrets ---
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx

# --- Docker ---
docker/.env.*
!docker/.env.template
!docker/dev/.env.template
!docker/mycom/.env.template
!docker/prod/.env.template
!docker/_common/.env.example
docker/_common/docker-compose.playwright.yml
docker/_common/volume/
docker/test_cron.py
*.log

# --- OS ---
.DS_Store
Thumbs.db

# --- Backup / Temp ---
*.bak
*.bak*
*.tmp
~$*
*_bak_*

# --- Local config (use *.example as template) ---


# --- Runtime data (bind mounted from host) ---
workspaces/
/memory/
/MEMORY.md
/PROFILE.md
/SOUL.md
/AGENTS.md
/HEARTBEAT.md
*.json.lock
.reme_store_v1
.bootstrap_completed

# --- Debug / temp scripts (root directory) ---
debug_config*.py
fix_*.py
find_bad_jobs.py
test_*.py
verify_*.py

# --- Dev test scripts ---
tests/dev/

# --- Screenshot / verify images ---
*.png

# --- One-time docs ---
PROJECT_REORGANIZATION_COMPLETE.md

# --- Reports (generated / internal) ---
docs/*.docx
docs/*.js
docs/package*.json

# --- Scripts (local dev only) ---
/scripts/

# --- Client build artifacts ---
client/node_modules/.tmp
client/dist/

# --- Playwright browser binaries (too large for git) ---
docker/volume/
server/deploy/chromium-cache/

# --- Dev-only docker compose ---
docker/docker-compose.dev.yaml
docker/docker-compose-mycom.yml

# --- Standalone dev/ops scripts (not part of coapis package) ---
server/configure_llm.py
server/restart_backend.py

# --- Technical documentation ---
# tech_docs/ is now versioned (design documents, architecture, etc.)
# tech_docs/

# --- Marketing documents (local only, not for git) ---
tech_docs/go/
