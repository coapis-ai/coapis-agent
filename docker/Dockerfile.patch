# Patch image: copy only changed files onto coapis-agent:latest
FROM coapis-agent:latest

# Copy the fixed runner module
COPY server/coapis/app/runner/runner.py /app/coapis/app/runner/runner.py

# Fix: ContextCompressor now reads config from agent_config.running.light_context_config
COPY server/coapis/agents/context_compressor.py /app/coapis/agents/context_compressor.py
COPY server/coapis/agents/workspace.py /app/coapis/agents/workspace.py

# Fix: rename request param to avoid @require_permission decorator conflict
COPY server/coapis/app/routers/tags.py /app/coapis/app/routers/tags.py

# Fix: 修复场景管理API @require_permission装饰器参数签名问题
COPY server/coapis/app/routers/admin_scenes.py /app/coapis/app/routers/admin_scenes.py

# Fix: 修复用户子智能体/场景智能体找不到技能的问题 - 在resolve_effective_skills中补充workspaces/{username}/skills/{agent_id}搜索路径
COPY server/coapis/agents/skills_manager.py /app/coapis/agents/skills_manager.py

# Fix: unify MCP manager access across workspace implementations
COPY server/coapis/app/routers/mcp.py /app/coapis/app/routers/mcp.py

# feat: unify workbench second-level menu using tags system
COPY server/coapis/app/services/tag_service.py /app/coapis/app/services/tag_service.py
COPY server/coapis/app/routers/menus.py /app/coapis/app/routers/menus.py

# feat: MCP Gateway + Internal User Temporary Token (JWT) mechanism for multi-tenant authentication
COPY server/coapis/app/auth.py /app/coapis/app/auth.py
COPY server/coapis/app/mcp/gateway.py /app/coapis/app/mcp/gateway.py

# Fix: onboarding/complete API - use module-level WORKSPACES_DIR import
COPY server/coapis/app/routers/auth.py /app/coapis/app/routers/auth.py

# Fix: bootstrap identity extraction from conversation
COPY server/coapis/agents/hooks/bootstrap.py /app/coapis/agents/hooks/bootstrap.py
